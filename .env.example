# BioPass Community — single env file for Docker Compose and local API.
#   cp .env.example .env
#   echo "AUTH_SECRET=$(openssl rand -hex 32)" >> .env   # or edit AUTH_SECRET=
#   docker compose up --build -d
# Then open http://localhost:3030/#/setup
#
# Local API (`cd backend && yarn dev`): same file is loaded from the repo root.
# Admin UI (`cd frontend && pnpm dev`): no env file needed (Vite defaults + proxy).

# Required for Compose / production
AUTH_SECRET=
POSTGRES_PASSWORD=

# Optional — public URL / CORS (defaults to http://localhost:3030)
# PUBLIC_BASE_URL=https://biopass.example.com
# FRONTEND_ORIGIN=https://biopass.example.com
# CORS_ORIGINS=https://biopass.example.com

# Optional — Compose project name (default in compose files: biopass-community)
# Avoids clashing with an older stack that used project name `biopass`.
# COMPOSE_PROJECT_NAME=biopass-community

# Optional — GHCR image (docker-compose.ghcr.yml)
# Forks: BIOPASS_IMAGE=ghcr.io/<your-owner>/biopass-community
# BIOPASS_IMAGE=ghcr.io/fhwang0926/biopass-community
# IMAGE_TAG=latest          # stable release (published from git tag vX.Y.Z)
# IMAGE_TAG=0.1.0           # pin a release version
# IMAGE_TAG=dev             # latest build from the `dev` branch
# IMAGE_TAG=dev.20260803    # UTC date snapshot from `dev`

# Optional — database (set POSTGRES_PASSWORD above for Compose; match DATABASE_URL)
# DATABASE_URL=postgresql://biopass:YOUR_PASSWORD@localhost:5432/biopass
# DB_HOST=localhost
# DB_USER=biopass
# DB_PASS=YOUR_PASSWORD
# DB_NAME=biopass
# DB_PORT=5432

# Optional — headless first admin (both email + password required to skip /#/setup)
# INIT_ADMIN_EMAIL=admin@example.com
# INIT_ADMIN_PASSWORD=
# INIT_ADMIN_NAME=Admin
# INIT_ADMIN_PHONE=

# Optional — JWT lifetimes
# AUTH_ACCESS=6h
# AUTH_REFRESH=7d
# AUTH_ACCESS_APP=1d

# Optional — SMTP (all of HOST + USER + PASS required to enable outbound mail)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SERVICE=

# Optional — Firebase push (place JSON under backend/json/ or the Compose json volume)
# FIREBASE_SERVICE_ACCOUNT_JSON=firebase-service-account.json

# Optional — companion Bio Pass app store links (shown on auth/guide pages)
# APP_DOWNLOAD_URL_IOS=https://apps.apple.com/kr/app/bio-pass/id6760216314
# APP_DOWNLOAD_URL_ANDROID=
# APP_DEEP_LINK_SCHEME=biopass
# APP_PACKAGE_ANDROID=com.mfa.biopass

# Optional — reverse proxy / ops
# TRUST_PROXY=1
# ENABLE_SWAGGER=0
# SKIP_AUTO_SCHEMA_SYNC=0
# ALLOW_SCHEMA_FORCE=0
# CONTACT_EMAIL=admin@example.com
# MAINTENANCE_EMAIL=
# TZ_OFFSET=+00:00
# PORT=3030
